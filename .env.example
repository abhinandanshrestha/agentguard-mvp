# AgentGuard Configuration
# Copy this file to .env and adjust values as needed.

# Runtime environment: development, test, or ci
AGENTGUARD_ENVIRONMENT=development

# PostgreSQL Database connection string (required)
# Format: postgresql://user:password@host:port/database
AGENTGUARD_DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard

# Maximum agent revision attempts per task (1-10)
AGENTGUARD_MAX_AGENT_ATTEMPTS=3

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
AGENTGUARD_LOG_LEVEL=INFO

# WeatherAPI Configuration (required for data fetching)
# Get your free API key from: https://www.weatherapi.com/
WEATHERAPI_KEY=your_api_key_here

# LLM Configuration (required for running agents on benchmark tasks)
#
# Default: Anthropic API
# Get your key from: https://console.anthropic.com/settings/keys
AGENTGUARD_LLM_PROVIDER=anthropic
AGENTGUARD_LLM_API_KEY=sk-ant-your_key_here
AGENTGUARD_LLM_BASE_URL=https://api.anthropic.com
AGENTGUARD_LLM_MODEL=claude-sonnet-4-5

# Alternative: OpenAI-compatible providers (set provider accordingly)
#   AGENTGUARD_LLM_PROVIDER=openai_compatible
#
#   OpenAI:      AGENTGUARD_LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  AGENTGUARD_LLM_BASE_URL=https://openrouter.ai/api/v1
#   DeepSeek:    AGENTGUARD_LLM_BASE_URL=https://api.deepseek.com/v1
#   Groq:        AGENTGUARD_LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:      AGENTGUARD_LLM_BASE_URL=http://localhost:11434/v1
#   LM Studio:   AGENTGUARD_LLM_BASE_URL=http://localhost:1234/v1

# Sampling temperature (0.0 = deterministic, 2.0 = very random)
AGENTGUARD_LLM_TEMPERATURE=0.2
# Maximum tokens in the LLM response
AGENTGUARD_LLM_MAX_TOKENS=2048
# Request timeout in seconds
AGENTGUARD_LLM_TIMEOUT=120

# Optional: Override default paths (relative to project root)
# AGENTGUARD_BENCHMARK_DIR=./benchmark
# AGENTGUARD_POLICIES_PATH=./policies/default_policies.yaml
# AGENTGUARD_RESULTS_DIR=./results
